# Shared demo hub (Railway). Leave empty locally to use the Vite proxy
# to http://localhost:4000. This is a public URL, not a secret.
VITE_SIMULATOR_URL=

# OpenRouter — used by the agent reasoning/TTS service.
# Copy to .env and fill in. Never commit the filled-in file.
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=

# Comma-separated model ids.
VITE_AGENT_CHAT_MODELS=openrouter/free
VITE_AGENT_TTS_MODELS=
